-- Extra 4: JOIN with NOT
-- Scenario: Data check: find cash donations made before the start date of their campaign (should return no rows).
SELECT d.donation_id, d.donation_date, c.start_date
FROM Donation d
JOIN Campaign c ON d.campaign_id = c.campaign_id
WHERE d.donation_type = 'Cash' AND NOT d.donation_date >= c.start_date;

-- Extra 5: OR on Category and Quantity
-- Scenario: List food items or any item with a quantity greater than 10.
SELECT item_name, category, quantity
