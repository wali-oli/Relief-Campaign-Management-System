CREATE OR REPLACE TRIGGER trg_location_id
BEFORE INSERT ON Location FOR EACH ROW
BEGIN
    :NEW.location_id := 'L' || LPAD(seq_location.NEXTVAL, 3, '0');
END;
/

CREATE OR REPLACE TRIGGER trg_campaign_id
BEFORE INSERT ON Campaign FOR EACH ROW
BEGIN
    :NEW.campaign_id := 'C' || LPAD(seq_campaign.NEXTVAL, 3, '0');
END;
/

CREATE OR REPLACE TRIGGER trg_volunteer_id
BEFORE INSERT ON Volunteer FOR EACH ROW
BEGIN
    :NEW.volunteer_id := 'V' || LPAD(seq_volunteer.NEXTVAL, 3, '0');
END;
/

CREATE OR REPLACE TRIGGER trg_donor_id
BEFORE INSERT ON Donor FOR EACH ROW
BEGIN
    :NEW.donor_id := 'D' || LPAD(seq_donor.NEXTVAL, 3, '0');
END;
/

CREATE OR REPLACE TRIGGER trg_donation_id
BEFORE INSERT ON Donation FOR EACH ROW
BEGIN
    :NEW.donation_id := 'DN' || LPAD(seq_donation.NEXTVAL, 3, '0');
END;
/

CREATE OR REPLACE TRIGGER trg_items_id
BEFORE INSERT ON Items FOR EACH ROW
BEGIN
    :NEW.item_id := 'I' || LPAD(seq_items.NEXTVAL, 3, '0');
END;
/

