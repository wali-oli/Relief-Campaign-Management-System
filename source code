-- 11.1 Display Donor Name by ID
SET SERVEROUTPUT ON;
DECLARE
    v_name Donor.donor_name%TYPE;
BEGIN
    SELECT donor_name
    INTO v_name
    FROM Donor
    WHERE donor_id = 'D001';

    DBMS_OUTPUT.PUT_LINE('Donor Name: ' || v_name);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Donor not found.');
END;
/

-- 11.2 Calculate Total Food Quantity (kg)
SET SERVEROUTPUT ON;
DECLARE
    v_total NUMBER;
BEGIN
    SELECT SUM(quantity)
    INTO v_total
    FROM Items
    WHERE unit = 'kg';

    DBMS_OUTPUT.PUT_LINE('Total Quantity Donated (kg): ' || v_total);
END;
/

-- 11.3 Check Volunteer Availability
SET SERVEROUTPUT ON;
DECLARE
    v_status Volunteer.availability_status%TYPE;
BEGIN
    SELECT availability_status
    INTO v_status
    FROM Volunteer
    WHERE volunteer_id = 'V001';

    IF v_status = 'Available' THEN
        DBMS_OUTPUT.PUT_LINE('Volunteer is available.');
    ELSIF v_status = 'Busy' THEN
        DBMS_OUTPUT.PUT_LINE('Volunteer is busy.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Volunteer is unavailable.');
    END IF;
END;
/

-- 11.4 Cursor to Display Available Volunteers
SET SERVEROUTPUT ON;
DECLARE
    CURSOR c_volunteer IS
        SELECT volunteer_name, role
        FROM Volunteer
        WHERE availability_status = 'Available';
BEGIN
    FOR r IN c_volunteer LOOP
        DBMS_OUTPUT.PUT_LINE(r.volunteer_name || ' - ' || r.role);
    END LOOP;
END;
/

-- 11.5 Procedure to Display Campaign Information
CREATE OR REPLACE PROCEDURE show_campaign
(
    p_campaign_id VARCHAR2
)
IS
    v_desc   Campaign.description%TYPE;
    v_status Campaign.status%TYPE;
    v_place  Location.location_name%TYPE;
BEGIN
    SELECT c.description, c.status, l.location_name
    INTO v_desc, v_status, v_place
    FROM Campaign c
    JOIN Location l ON c.location_id = l.location_id
    WHERE TRIM(c.campaign_id) = p_campaign_id;

    DBMS_OUTPUT.PUT_LINE('Campaign: ' || v_desc);
    DBMS_OUTPUT.PUT_LINE('Status: ' || v_status);
    DBMS_OUTPUT.PUT_LINE('Location: ' || v_place);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Campaign not found.');
END;
/

SET SERVEROUTPUT ON;
BEGIN
    show_campaign('C001');
END;
