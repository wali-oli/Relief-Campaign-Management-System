WHERE category = 'Food' OR quantity > 10;

-- Extra 6: NOT with OR
-- Scenario: List volunteers who are neither coordinators nor managers.
SELECT volunteer_name, role
FROM Volunteer
WHERE NOT (role = 'Coordinator' OR role = 'Manager');

-- Extra 7: IN
-- Scenario: List items that belong to the Food or Cloth category.
SELECT item_name, category, quantity
FROM Items
WHERE category IN ('Food', 'Cloth');

-- Extra 8: SOME with Dates
-- Scenario: Find campaigns that started before at least one donation date.
SELECT campaign_id, description, start_date
FROM Campaign
WHERE start_date < SOME (SELECT donation_date FROM Donation);

-- Extra 9: ALL with Dates
-- Scenario: Find donations made before the end date of every campaign.
SELECT donation_id, donation_date
FROM Donation
WHERE donation_date < ALL (SELECT end_date FROM Campaign);

-- Extra 10: EXISTS (Campaigns with Donations)
-- Scenario: List campaigns that have received at least one donation.
SELECT campaign_id, description
FROM Campaign c
WHERE EXISTS (SELECT 1 FROM Donation d WHERE d.campaign_id = c.campaign_id);

-- Extra 11: UPPER and LOWER
-- Scenario: Show donor names in capital letters and e-mail addresses in small letters.
SELECT UPPER(donor_name) AS upper_name, LOWER(email) AS lower_email
FROM Donor;

-- Extra 12: TO_CHAR
-- Scenario: Extract the year from each donation date.
SELECT donation_id, TO_CHAR(donation_date, 'YYYY') AS donation_year
FROM Donation;

-- Extra 13: LENGTH
-- Scenario: Show the length of each volunteer name in bytes and in characters.
SELECT volunteer_name,
       LENGTHB(volunteer_name) AS name_len,
       LENGTH(volunteer_name) AS chars
FROM Volunteer;

-- Extra 14: REPLACE
-- Scenario: Change the word Dhaka to Dhaka City in donor addresses.
SELECT donor_name, REPLACE(address, 'Dhaka', 'Dhaka City') AS formatted_address
FROM Donor;

-- Extra 15: RIGHT JOIN
-- Scenario: Show all campaigns, including campaigns that have received no donation yet.
SELECT dn.donation_id, c.campaign_id, c.description
FROM Donation dn
RIGHT JOIN Campaign c ON dn.campaign_id = c.campaign_id;


