-- 9.1 Nested Query using WHERE and IN
-- Scenario: Find the donors who have made at least one cash donation.
SELECT donor_name
FROM Donor
WHERE donor_id IN
(
    SELECT donor_id
    FROM Donation
    WHERE donation_type = 'Cash'
);

-- 9.2 Locations of Completed Campaigns
-- Scenario: Find the locations where a relief campaign has already been completed.
SELECT location_name
FROM Location
WHERE location_id IN
(
    SELECT location_id
    FROM Campaign
    WHERE status = 'Completed'
);

-- 9.3 Update Data
-- Scenario: The Winter Clothes Collection campaign (C004) has started, so its status is changed from Planned to Ongoing.
UPDATE Campaign
SET status = 'Ongoing'
WHERE campaign_id = 'C004';

COMMIT;

-- 9.4 WITH Clause & SUM
-- Scenario: Calculate the total quantity of goods received in each donation.
WITH ItemSummary AS
(
    SELECT donation_id, SUM(quantity) Total_Quantity
    FROM Items
    GROUP BY donation_id
)
SELECT * FROM ItemSummary
ORDER BY donation_id;

-- 9.5 WITH Clause & COUNT
-- Scenario: Count how many donations each campaign has received.
WITH DonationSummary AS
(
    SELECT campaign_id, COUNT(*) Total_Donations
    FROM Donation
    GROUP BY campaign_id
)
SELECT * FROM DonationSummary
ORDER BY campaign_id;

-- 9.6 GROUP BY & COUNT
-- Scenario: Count the number of donations of each donation type.
SELECT donation_type, COUNT(*) Total_Donations
FROM Donation
GROUP BY donation_type
ORDER BY donation_type;

-- 9.7 Two-level Nested Query: Latest Donation
-- Scenario: Find the donor who made the most recent donation.
SELECT *
FROM Donor
WHERE donor_id =
(
    SELECT donor_id
    FROM Donation
    WHERE donation_date =
    (
        SELECT MAX(donation_date)
        FROM Donation
    )
);

-- 9.8 Two-level Nested Query: Latest Campaign Location
-- Scenario: Find the location of the campaign that starts last.
SELECT *
FROM Location
WHERE location_id =
(
    SELECT location_id
    FROM Campaign
    WHERE start_date =
    (
        SELECT MAX(start_date)
        FROM Campaign
    )
);

-- 9.9 LIKE with %
-- Scenario: Find all volunteers whose name starts with the letter R.
SELECT *
FROM Volunteer
WHERE volunteer_name LIKE 'R%';

-- 9.10 LIKE with _
-- Scenario: Find donors whose name has 'a' as the second letter.
SELECT donor_name, address
FROM Donor
WHERE donor_name LIKE '_a%';

-- 9.11 AND (using a View)
-- Scenario: Create a view of available volunteers, then find the available coordinator whose phone number starts with 0171.
CREATE OR REPLACE VIEW Available_Volunteer AS
SELECT * FROM Volunteer
WHERE availability_status = 'Available';

SELECT *
FROM Available_Volunteer
WHERE role = 'Coordinator'
AND phone LIKE '0171%';

-- 9.12 OR (using the View)
-- Scenario: Find available volunteers who are either coordinators or drivers.
SELECT *
FROM Available_Volunteer
WHERE role = 'Coordinator'
OR role = 'Driver';

-- 9.13 NOT (using the View)
-- Scenario: Find available volunteers who are not coordinators.
SELECT *
FROM Available_Volunteer
WHERE NOT role = 'Coordinator';

-- 9.14 SOME
-- Scenario: Find items whose quantity is greater than at least one Cloth item quantity.
SELECT item_id, item_name, category, quantity
FROM Items
WHERE quantity > SOME
(
    SELECT quantity
    FROM Items
    WHERE category = 'Cloth'
);

-- 9.15 ALL
-- Scenario: Find the item with the largest quantity (greater than or equal to every quantity).
SELECT item_id, item_name, category, quantity
FROM Items
WHERE quantity >= ALL
(
    SELECT quantity
    FROM Items
);

-- 9.16 EXISTS
-- Scenario: Find donors who have made at least one donation.
SELECT donor_name
FROM Donor d
WHERE EXISTS
(
    SELECT *
    FROM Donation dn
    WHERE d.donor_id = dn.donor_id
);

-- 9.17 OR with LIKE
-- Scenario: List donors who live in Dhaka or Chittagong.
SELECT donor_name, address
FROM Donor
WHERE address LIKE '%Dhaka%' OR address LIKE '%Chittagong%';

-- 9.18 AND, OR and BETWEEN Together
-- Scenario: Find cash donations made in July 2026 or donations that belong to campaign C001.
SELECT donation_id, donation_type, donation_date
FROM Donation
WHERE donation_type = 'Cash'
  AND (donation_date BETWEEN DATE '2026-07-01' AND DATE '2026-07-31'
       OR campaign_id = 'C001');

-- 9.19 UNION
-- Scenario: List every person's name, whether the person is a donor or a volunteer (duplicates removed).
SELECT donor_name AS person_name FROM Donor
UNION
SELECT volunteer_name FROM Volunteer;

-- 9.20 INTERSECT
-- Scenario: Find people who are both donors and volunteers.
SELECT donor_name FROM Donor
INTERSECT
SELECT volunteer_name FROM Volunteer;

-- 9.21 MINUS
-- Scenario: Find donors who are not volunteers.
SELECT donor_name FROM Donor
MINUS
SELECT volunteer_name FROM Volunteer;

-- 9.22 NOT IN
-- Scenario: List volunteers whose role is not Coordinator or Manager.
SELECT volunteer_name, role
FROM Volunteer
WHERE role NOT IN ('Coordinator', 'Manager');

-- 9.23 NOT EXISTS
-- Scenario: List campaigns that have not received any donation yet.
SELECT campaign_id, description
FROM Campaign c
WHERE NOT EXISTS (SELECT 1 FROM Donation d WHERE d.campaign_id = c.campaign_id);

-- 9.24 String Concatenation (||)
-- Scenario: Show the complete address of every location in a single column.
SELECT location_name, address || ', ' || district || ', ' || division AS full_address
FROM Location;

-- 9.25 SUBSTR
-- Scenario: Split each donor ID into its letter prefix and number (TRIM removes the blank padding of CHAR columns).
SELECT donor_id,
       SUBSTR(TRIM(donor_id), 1, 1) AS prefix,
       SUBSTR(TRIM(donor_id), -3) AS id_number
FROM Donor;

-- 9.26 INNER JOIN
-- Scenario: Show every donation together with the name of the donor who made it.
SELECT d.donor_name, dn.donation_id, dn.donation_type
FROM Donor d
JOIN Donation dn ON d.donor_id = dn.donor_id;

-- 9.27 LEFT JOIN
-- Scenario: Show all donors, including donors who have not donated yet.
SELECT d.donor_name, dn.donation_id
FROM Donor d
LEFT JOIN Donation dn ON d.donor_id = dn.donor_id;

-- 9.28 FULL OUTER JOIN
-- Scenario: Match donors with volunteers by name; unmatched donors and unmatched volunteers are also shown.
SELECT d.donor_name, v.volunteer_name
FROM Donor d
FULL OUTER JOIN Volunteer v ON d.donor_name = v.volunteer_name;

-- 9.29 CROSS JOIN
-- Scenario: List every possible location for the campaign C006 that is still in the planning stage.
SELECT c.campaign_id, l.location_name
FROM Campaign c
CROSS JOIN Location l
WHERE c.status = 'Planned' AND c.campaign_id = 'C006';

