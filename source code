
SET LINESIZE 1000
SET PAGESIZE 1000
SET SERVEROUTPUT ON
ALTER SESSION SET NLS_DATE_FORMAT = 'YYYY-MM-DD';

CREATE TABLE Location (
    location_id   CHAR(20) PRIMARY KEY,
    location_name VARCHAR2(100) NOT NULL,
    address       VARCHAR2(255) NOT NULL,
    district      VARCHAR2(100),
    division      VARCHAR2(100)
);

CREATE TABLE Campaign (
    campaign_id   CHAR(20) PRIMARY KEY,
    campaign_date DATE NOT NULL,
    description   VARCHAR2(500),
    start_date    DATE NOT NULL,
    end_date      DATE,
    status        VARCHAR2(20) DEFAULT 'Planned'
                  CHECK (status IN ('Planned','Ongoing','Completed','Cancelled')),
    location_id   CHAR(20),
    FOREIGN KEY (location_id) REFERENCES Location(location_id)
);

CREATE TABLE Volunteer (
    volunteer_id        CHAR(20) PRIMARY KEY,
    volunteer_name      VARCHAR2(100) NOT NULL,
    phone               VARCHAR2(15),
    email               VARCHAR2(100),
    role                VARCHAR2(100),
    availability_status VARCHAR2(20) DEFAULT 'Available'
                        CHECK (availability_status IN ('Available','Busy','Unavailable'))
);

CREATE TABLE Donor (
    donor_id   CHAR(20) PRIMARY KEY,
    donor_name VARCHAR2(100) NOT NULL,
    phone      VARCHAR2(15),
    email      VARCHAR2(100),
    address    VARCHAR2(255)
);

CREATE TABLE Donation (
    donation_id   CHAR(25) PRIMARY KEY,
    donor_id      CHAR(20) NOT NULL,
    campaign_id   CHAR(20),
    donation_type VARCHAR2(10) DEFAULT 'Other'
                  CHECK (donation_type IN ('Cash','Item','Food','Other')),
    donation_date DATE NOT NULL,
    FOREIGN KEY (donor_id)    REFERENCES Donor(donor_id),
    FOREIGN KEY (campaign_id) REFERENCES Campaign(campaign_id)
);

CREATE TABLE Campaign_Volunteer (
    campaign_id   CHAR(20) NOT NULL,
    volunteer_id  CHAR(20) NOT NULL,
    assigned_role VARCHAR2(100),
    assigned_date DATE,
    PRIMARY KEY (campaign_id, volunteer_id),
    FOREIGN KEY (campaign_id)  REFERENCES Campaign(campaign_id),
    FOREIGN KEY (volunteer_id) REFERENCES Volunteer(volunteer_id)
);

CREATE TABLE Items (
    item_id     CHAR(20) PRIMARY KEY,
    donation_id CHAR(25) NOT NULL,
    item_name   VARCHAR2(150) NOT NULL,
    category    VARCHAR2(100),
    quantity    NUMBER(10) DEFAULT 1 NOT NULL,
    unit        VARCHAR2(50),
    FOREIGN KEY (donation_id) REFERENCES Donation(donation_id)
);


ALTER TABLE Donor ADD donor_type VARCHAR2(20);
ALTER TABLE Donor MODIFY donor_type VARCHAR2(50);
ALTER TABLE Donor RENAME COLUMN donor_type TO donor_category;
ALTER TABLE Donor DROP COLUMN donor_category;


